{
  "name": "pharma-bid-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Unified local launcher for the FastAPI backend with React as the primary web frontend and Flutter retained for rollback.",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1",
    "start:flutter": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1 -FrontendMode flutter",
    "start:react": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1 -FrontendMode react",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-down.ps1",
    "stop:flutter": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-down.ps1",
    "test:start": "node --test ./scripts/tests/npm-start.test.mjs",
    "test:web": "npm --prefix ./web test",
    "build:web": "npm --prefix ./web run build"
  }
}
