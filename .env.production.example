# Copy to .env.production and replace both values before first startup.
CRAWLER_BOOTSTRAP_ADMIN_USERNAME=admin
CRAWLER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Listen on all intranet interfaces by default. Change to a specific server IP if required.
INTRANET_BIND_ADDRESS=0.0.0.0
INTRANET_PORT=8093

# Optional company outbound proxy. Leave empty when direct internet access is available.
CRAWLER_OUTBOUND_PROXY_URL=
CRAWLER_USE_SYSTEM_PROXY=true
CRAWLER_OUTBOUND_NO_PROXY=localhost,127.0.0.1,::1,service.most.gov.cn,gdstc.gd.gov.cn,kjj.gz.gov.cn,www.hp.gov.cn,www.hengqin.gov.cn,kjt.hunan.gov.cn,kjj.changsha.gov.cn

# Same-origin Nginx deployment does not need browser CORS.
CRAWLER_CORS_ALLOWED_ORIGINS=
CRAWLER_CORS_ALLOWED_ORIGIN_REGEX=
CRAWLER_MAINTENANCE_ENABLED=true
