# Set both bootstrap vars together to create a startup admin account.
CRAWLER_BOOTSTRAP_ADMIN_USERNAME=
CRAWLER_BOOTSTRAP_ADMIN_PASSWORD=
CRAWLER_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8093,http://localhost:8093
CRAWLER_CORS_ALLOWED_ORIGIN_REGEX=
CRAWLER_OUTBOUND_PROXY_URL=
CRAWLER_USE_SYSTEM_PROXY=true
CRAWLER_OUTBOUND_NO_PROXY=localhost,127.0.0.1,::1
CRAWLER_AUTOMATIC_RETRY_MINUTES=15
API_BASE_URL=http://127.0.0.1:8000
